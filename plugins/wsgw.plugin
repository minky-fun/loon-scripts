#!name=网上国网(wSGW)
#!desc=网上国网电量数据重写（供 SGCC_Mod 小组件拉取电费数据，需配合 BoxJS 配置 95598 账号密码使用）
#!system=ios
#!author=小白脸|𝐎𝐍𝐙𝟑𝐕 (modified from @Yuheng0101) / Loon port for SGCC_Mod
#!homepage=https://github.com/dompling/Script
#!icon=https://raw.githubusercontent.com/Honye/scriptable-scripts/master/static/sgcc.png
#!tag=wsgw,网上国网,电网

# 免责声明：
# 1. 本插件仅供个人学习、研究与自用，请勿用于商业用途或非法用途。
# 2. 重写脚本主体（index.js）原作者：小白脸 ONZ3V，改编自 @Yuheng0101；
#    数据来自国家电网接口，本插件仅作展示，不保存任何账号密码。
# 3. 使用前请先在 BoxJS 中添加订阅并配置「网上国网」账号密码：
#    https://raw.githubusercontent.com/Yuheng0101/X/main/Tasks/boxjs.json
# 4. 请开启代理 + 本插件 + MITM 后，再到 Scripting 中 SGCC_Mod 点「获取账户列表」。

[Script]
http-request ^https?:\/\/api\.wsgw-rewrite\.com\/electricity\/bill\/all script-path=https://raw.githubusercontent.com/dompling/Script/master/wsgw/index.js, requires-body=true, timeout=60, tag=网上国网数据

[Mitm]
hostname = %APPEND% api.wsgw-rewrite.com
